{
  "name": "gitleaks-secret-scanner-fixed",
  "version": "4.0.0",
  "description": "A TypeScript wrapper for the Gitleaks engine providing accurate, safe secret scanning for local pre-commit hooks and CI/CD pipelines.",
  "author": "Artur Polishchuk",
  "type": "module",
  "main": "dist/bin/cli.js",
  "bin": {
    "gitleaks-secret-scanner": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "preuninstall": "node scripts/preuninstall.cjs",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "pr-checkmate all",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "tar": "^7.5.22",
    "toml": "^5.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.3",
    "conventional-changelog-cli": "^5.0.0",
    "pr-checkmate": "3.0.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "husky": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "husky": {
      "optional": true
    }
  },
  "overrides": {
    "conventional-changelog-angular": "8.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mybono/gitleaks-secret-scanner.git"
  },
  "homepage": "https://github.com/Mybono/gitleaks-secret-scanner#readme",
  "keywords": [
    "security",
    "gitleaks",
    "pre-commit",
    "secrets-scanning",
    "git-hooks",
    "toml"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/Mybono/gitleaks-secret-scanner/issues"
  }
}
